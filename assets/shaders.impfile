# Shader for a tile map
"tile_shader" {
	"vertex" = "assets/shaders/tilemap_vert.glsl";
	"fragment" = "assets/shaders/tilemap_frag.glsl";
}

# Shader for a sprite
"sprite_shader" {
	"vertex" = "assets/shaders/sprite_vert.glsl";
	"fragment" = "assets/shaders/sprite_frag.glsl";
}

# Shader for a shadow
"shadow_shader" {
	"vertex" = "assets/shaders/sprite_vert.glsl";
	"fragment" = "assets/shaders/shadow_frag.glsl";
}

# Shader for tile shadows
"tile_shadow_shader" {
	"vertex" = "assets/shaders/sprite_vert.glsl";
	"fragment" = "assets/shaders/tile_shadow_frag.glsl";
}

# Shader for particles
"particle_shader" {
	"vertex" = "assets/shaders/sprite_vert.glsl";
	"fragment" = "assets/shaders/particle_frag.glsl";
}

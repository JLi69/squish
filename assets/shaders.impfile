# Shader for a tile map
"tile_shader" {
	"vertex" = "assets/shaders/tilemap_vert.glsl";
	"fragment" = "assets/shaders/tilemap_frag.glsl";
}

# Shader for a sprite
# This is for sprites in the game world and adds some shading in order to
# create a "3D" effect.
"sprite_shader" {
	"vertex" = "assets/shaders/sprite_vert.glsl";
	"fragment" = "assets/shaders/sprite_frag.glsl";
}

# Shader for a shadow
"shadow_shader" {
	"vertex" = "assets/shaders/sprite_vert.glsl";
	"fragment" = "assets/shaders/shadow_frag.glsl";
}

# Shader for tile shadows
"tile_shadow_shader" {
	"vertex" = "assets/shaders/sprite_vert.glsl";
	"fragment" = "assets/shaders/tile_shadow_frag.glsl";
}

# Shader for sprites that are to be drawn without any shading
"flat_sprite_shader" {
	"vertex" = "assets/shaders/sprite_vert.glsl";
	"fragment" = "assets/shaders/flat_frag.glsl";
}

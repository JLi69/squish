# This is a list of sound effects to be imported
# Sound effects have one variable: 'path', the path the sfx file (a .wav file)

"explosion" {
	"path" = "assets/sfx/explosion.wav";
	"gain" = "12.0";
	"rolloff" = "0.25";
}

"splat" {
	"path" = "assets/sfx/splat.wav";
	"gain" = "0.25";
	"rolloff" = "2.5";
	"pitch" = "1.7";
}
